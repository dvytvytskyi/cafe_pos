datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions Json     // Матриця прав доступу
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id             String      @id @default(uuid())
  name           String
  pinHash        String      // Захешований PIN-код для входу на терміналі
  passwordHash   String?     // Dashboard login password (scrypt)
  roleId         String
  role           Role        @relation(fields: [roleId], references: [id])
  locations      Location[]  @relation("UserLocations")
  shifts         CashShift[]
  timeCards      TimeCard[]
  shiftSchedules ShiftSchedule[]
  ordersTaken    Order[]     @relation("OrderTakenBy")
  ordersServed   Order[]     @relation("OrderServedBy")
  ordersClosed   Order[]     @relation("OrderClosedBy")
  ordersAssigned Order[]     @relation("OrderAssigned")
  itemsSold      OrderItem[] @relation("ItemSoldBy")
  tablesAssigned Table[]     @relation("TableAssigned")
  
  // Employee details
  position       String?
  section        String?     // "Floor" | "Kitchen"
  nie            String?
  phone          String?
  email          String?     @unique
  contractStart  String?
  contractEnd    String?
  scheduleStart  String?
  scheduleEnd    String?
  daysPerWeek    Int?        @default(5)
  avatarInitials String?
  avatarUrl      String?
  status         String?     @default("active") // "active" | "inactive"

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Location {
  id             String                  @id @default(uuid())
  name           String
  address        String?
  users          User[]                  @relation("UserLocations")
  tables         Table[]
  orders         Order[]
  shifts         CashShift[]
  tasks          Task[]
  layoutMetadata Json?                   // Room zones and obstacles details
  inventoryStock InventoryLocationStock[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
}

model Table {
  id         String   @id @default(uuid())
  number     String
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  x          Float    // SVG X
  y          Float    // SVG Y
  width      Float    // SVG Width
  height     Float    // SVG Height
  shape      String   // "round" | "square" | "custom"
  status     String   // "available" | "occupied" | "billed" | "dirty"
  qrCodeUrl  String?
  
  // Room association & details
  roomId     String?
  roomName   String?
  seats      Int?     @default(4)
  assignedStaffId String?
  assignedStaff   User? @relation("TableAssigned", fields: [assignedStaffId], references: [id])

  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MenuCategory {
  id             String          @id @default(uuid())
  name           String
  sortOrder      Int             @default(0)
  isArchived     Boolean         @default(false)
  defaultTaxSlug String?         // Guava category taxPercentage → food | alcohol | exempt
  items          MenuItem[]
  modifierGroups ModifierGroup[] @relation("CategoryModifierGroups")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ModifierGroup {
  id          String           @id @default(uuid())
  name        String
  minQty      Int              @default(0)
  maxQty      Int              @default(1)
  isArchived  Boolean          @default(false)
  sortOrder   Int              @default(0)
  options     ModifierOption[]
  categories  MenuCategory[]   @relation("CategoryModifierGroups")
  menuItems   MenuItem[]       @relation("MenuItemModifierGroups")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ModifierOption {
  id         String        @id @default(uuid())
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  price      Float         @default(0)
  isArchived Boolean       @default(false)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model MenuItem {
  id             String                @id @default(uuid())
  name           String
  description    String?
  price          Float
  categoryId     String
  category       MenuCategory          @relation(fields: [categoryId], references: [id])
  allergens      String[]              // Масив алергенів: ["nuts", "dairy"]
  tags           String[]              @default([])
  imageUrl       String?
  isVisible      Boolean               @default(true)
  locationIds    String[]              @default([])
  isArchived     Boolean               @default(false)
  sortOrder      Int                   @default(0)
  guavaSourceId  String?               // Original Guava menuItem.id (for re-import)
  recommendedItemIds String[]        @default([]) // Guest upsell / Guava recommended[]
  taxSlug          String?           // food | alcohol | exempt — IVA bucket from Guava
  channelPrices    Json?             // Per-channel overrides: glovo, ubereats, web, dine_in
  visibilitySchedule Json?           // Guava schedules[] — time slots when item is visible
  bundleDefinition Json?             // Guava bundles[] — combo components when present
  priceHistory   Json?                 // Історія цін
  translations   MenuItemTranslation[]
  modifierGroups ModifierGroup[]       @relation("MenuItemModifierGroups")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([categoryId, sortOrder])
  @@index([guavaSourceId])
}

model MenuItemTranslation {
  id          String   @id @default(uuid())
  itemId      String
  item        MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([itemId, locale])
  @@index([locale])
}

model Order {
  id            String         @id @default(uuid())
  orderNumber   String         @unique // Наприклад, ORD-001, GLV-12948
  source        String         // "dine_in" | "takeaway" | "glovo" | "ubereats"
  customerName  String?
  customerId    String?
  loyaltyGuestIds String[]     @default([])
  tableId       String?
  table         Table?         @relation(fields: [tableId], references: [id])
  locationId    String
  location      Location       @relation(fields: [locationId], references: [id])
  status        String         // "incoming" | "preparing" | "ready" | "served" | "completed" | "cancelled"
  total         Float
  discountName  String?
  discountValue Float          @default(0)
  discountType  String?        // "percent" | "fixed"
  tipType       String?        // "percent" | "fixed"
  tipValue      Float          @default(0)
  pointsToSpend Float          @default(0)
  guestCount    Int?
  takenByStaffId    String?
  takenByStaff      User?    @relation("OrderTakenBy", fields: [takenByStaffId], references: [id])
  servedByStaffId   String?
  servedByStaff     User?    @relation("OrderServedBy", fields: [servedByStaffId], references: [id])
  closedByStaffId   String?
  closedByStaff     User?    @relation("OrderClosedBy", fields: [closedByStaffId], references: [id])
  assignedStaffId   String?
  assignedStaff     User?    @relation("OrderAssigned", fields: [assignedStaffId], references: [id])
  isPrepaid     Boolean        @default(false)
  invoiceEmail  String?
  receiptsSentTo String[]      @default([])
  paid          Boolean        @default(false)
  amountPaid    Float          @default(0)
  refundedAmount Float         @default(0)
  items         OrderItem[]
  transactions  Transaction[]
  fiscalRecords FiscalRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([locationId, createdAt])
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name             String
  price            Float
  quantity         Int
  itemType         String   @default("food") // food | merch
  menuItemId       String?
  merchSkuId       String?
  taxSlug          String?  // Snapshot IVA bucket at order time
  modifierSnapshot Json?
  paid             Boolean  @default(false)
  comments         String?
  refundedQuantity Int      @default(0)
  guestIndex       Int?
  soldByStaffId    String?
  soldByStaff      User?    @relation("ItemSoldBy", fields: [soldByStaffId], references: [id])
  sentToKitchen    Boolean  @default(false)
  sentToBar        Boolean  @default(false)
  served           Boolean  @default(false)
  acceptedAt       DateTime?
  readyAt          DateTime?
  createdAt        DateTime @default(now())
}

model Transaction {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  method    String   // "card" | "cash" | "points" | "giftcard"
  amount    Float
  code      String?  // Код сертифіката чи транзакції терміналу
  cashTendered Float?
  changeGiven  Float?
  recordedByStaffId String?
  createdAt DateTime @default(now())

  @@index([method])
}

model FiscalRecord {
  id                     String         @id @default(uuid())
  orderId                String
  order                  Order          @relation(fields: [orderId], references: [id])
  recordType             String         @default("invoice") // "invoice" | "rectificativa"
  originalFiscalRecordId String?
  originalFiscalRecord   FiscalRecord?  @relation("Rectificativa", fields: [originalFiscalRecordId], references: [id])
  rectificativas         FiscalRecord[] @relation("Rectificativa")
  refundReason           String?
  invoiceNumber          String         @unique
  invoiceType            String         // "simplificada" | "completa" | "rectificativa"
  clientNif     String?
  clientName    String?
  clientAddress String?
  taxBase       Float
  taxRate       Float    @default(0.10) // Дефолтний ПДВ (IVA) в ресторанах Іспанії 10%
  taxAmount     Float
  total         Float
  prevHash      String   // Хеш попереднього чека в ланцюжку
  hash          String   // Поточний SHA-256 хеш (Huella Hash)
  signature     String?  // Цифровий підпис
  qrCodeUrl     String?  // URL для перевірки чека на сайті AEAT
  isSyncAEAT    Boolean  @default(false)
  syncError     String?  // Помилка синхронізації якщо була
  createdAt     DateTime @default(now())
}

model CashShift {
  id          String    @id @default(uuid())
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  floatStart  Float     // Початковий залишок розмінної монети
  cashSales   Float     @default(0)
  cardSales   Float     @default(0)
  pointsSales Float     @default(0)
  cashIn      Float     @default(0)
  cashOut     Float     @default(0)
  expected    Float     // Очікувана сума в касі
  actual      Float?    // Введена сума при закритті
  difference  Float?    // Недостача/надлишок (Shortage/Overage)
  adjustments Json?     // Detailed adjustments log [{ type, amount, reason, time }]
  status      String    // "open" | "closed"
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // e.g. "shift_open", "shift_close", "cash_adjustment", etc.
  details   Json?
  userId    String?
  prevHash  String
  hash      String
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model MerchInventory {
  id             String                   @id @default(uuid())
  sku            String                   @unique
  name           String
  price          Float
  quantity       Int                      @default(0)
  minStockLevel  Int                      @default(10)
  category       String                   @default("merch") // merch | kitchen | bar
  unit           String                   @default("pcs")
  guestVisible   Boolean                  @default(false)
  guestImageUrl  String?
  guestDescription String?
  transfers      InventoryTransfer[]
  stockTransfers StockTransfer[]
  locationStock  InventoryLocationStock[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

model InventoryLocationStock {
  id         String         @id @default(uuid())
  itemId     String
  item       MerchInventory @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId String
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([itemId, locationId])
  @@index([locationId])
}

model StockTransfer {
  id               String         @id @default(uuid())
  itemId           String
  item             MerchInventory @relation(fields: [itemId], references: [id])
  sourceLocationId String         @default("main")
  targetLocationId String
  quantity         Int
  status           String         @default("pending") // pending | in_transit | completed
  createdByName    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([itemId])
}

model InventoryTransfer {
  id        String         @id @default(uuid())
  itemId    String
  item      MerchInventory @relation(fields: [itemId], references: [id])
  type      String         // "check_in" (restock) | "check_out" (write-off/transfer) | "sale"
  quantity  Int            // Absolute quantity adjusted
  reason    String?
  createdAt DateTime       @default(now())
}

model Customer {
  id                String               @id @default(uuid())
  name              String
  phone             String               @unique
  email             String
  birthday          String?
  tier              String               @default("Bronze") // "Bronze" | "Silver" | "Gold" | "VIP"
  points            Float                @default(0.0)
  ltv               Float                @default(0.0)      // Lifetime value
  visitCount        Int                  @default(0)
  lastVisitDate     String?
  favoriteDishes    String[]             // Array of favorites
  allergyNotes      String?
  notes             String?
  joinedDate        String?
  phoneVerified     Boolean              @default(false)
  guestRegisteredAt DateTime?
  transactions      LoyaltyTransaction[]
  giftCards         GiftCard[]
  guestSessions     GuestSession[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model GuestSession {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model GuestOtpChallenge {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model LoyaltyConfig {
  id              String   @id @default("default")
  bronzeRate      Float    @default(0.05)
  silverRate      Float    @default(0.08)
  goldRate        Float    @default(0.10)
  vipRate         Float    @default(0.15)
  silverThreshold Float    @default(75.0)
  goldThreshold   Float    @default(150.0)
  vipThreshold    Float    @default(300.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LoyaltyTransaction {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  type       String   // "earn" | "spend"
  points     Float
  orderId    String?
  createdAt  DateTime @default(now())
}

model DiscountPreset {
  id        String   @id @default(uuid())
  name      String
  value     Float    // percentage (e.g., 50 for Staff Meal)
  colorTag  String?  @default("bg-gray-100 text-gray-700")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Promotion {
  id              String   @id @default(uuid())
  name            String
  discountPercent Float
  activeDays      Int[]    // e.g. [5] for Friday, [0] for Sunday
  startHour       Int      // 24h format
  endHour         Int      // 24h format
  targetItems     String[] // Array of item names affected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GiftCard {
  id             String    @id @default(uuid())
  code           String    @unique
  initialBalance Float
  balance        Float
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  status         String    @default("active") // "active" | "redeemed" | "expired" | "disabled"
  expiryDate     DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Task {
  id               String    @id @default(uuid())
  title            String
  description      String?
  branch           String    @default("All Branches")
  tags             Json      @default("[]")
  commentsCount    Int       @default(0)
  attachmentsCount Int       @default(0)
  progress         Int       @default(0)
  priority         String    @default("Lowest")
  dueAt            DateTime?
  scheduledDate    DateTime  @db.Date
  assigneeIds      String[]
  likedByIds       String[]  @default([])
  status           String    @default("todo")
  locationId       String?
  location         Location? @relation(fields: [locationId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([scheduledDate])
  @@index([status])
}

model BoardSettings {
  id         String   @id @default(uuid())
  type       String   // "orders" | "tasks"
  locationId String   @default("default")
  stages     Json     // [{ id, label, color }]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([type, locationId])
  @@index([type])
}

model ChecklistTemplate {
  id            String   @id @default(uuid())
  taskKey       String   @unique
  title         String
  requiresPhoto Boolean  @default(false)
  category      String   // "opening" | "closing"
  sortOrder     Int      @default(0)
  permissions   Json     // { gotico: true, sagrada: true, ... }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DailyChecklist {
  id            String    @id @default(uuid())
  shiftType     String    // "opening" | "closing"
  scheduledDate DateTime  @db.Date
  locationKey   String
  taskKey       String
  completed     Boolean   @default(false)
  photoUrl      String?
  completedAt   DateTime?
  completedById String?
  cashShiftId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([shiftType, scheduledDate, locationKey, taskKey])
  @@index([scheduledDate, shiftType])
}

model TimeCard {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDate     DateTime  @db.Date
  clockIn      DateTime
  clockOut     DateTime?
  totalMinutes Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, workDate])
  @@index([workDate])
  @@index([userId, clockOut])
}

model ShiftSchedule {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  dayOfWeek Int      // 0=Mon … 6=Sun
  startTime String   // HH:mm
  endTime   String   // HH:mm
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart, dayOfWeek])
  @@index([weekStart])
}

model SystemSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Printer {
  id         String   @id @default(cuid())
  name       String
  ipAddress  String
  port       Int      @default(9100)
  type       String
  locationId String   @default("default")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([locationId])
}

model TaxRate {
  id          String   @id @default(cuid())
  name        String
  slug        String
  ratePercent Float
  locationId  String   @default("default")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([locationId, slug])
  @@index([locationId])
}

model CustomerReview {
  id         String    @id @default(uuid())
  source     String    // GOOGLE | TRIPADVISOR | YELP
  rating     Int
  authorName String
  comment    String?
  replyText  String?
  repliedAt  DateTime?
  locationId String    @default("default")
  externalId String?
  reviewDate DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([source])
  @@index([locationId])
  @@index([reviewDate])
}


